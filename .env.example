# Required: OpenAI API key for transcription and LLM post-correction
OPENAI_API_KEY=sk-...

# Transcription model: gpt-4o-mini-transcribe, gpt-4o-transcribe, or whisper-1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ASR mode: openai or docker
ASR_MODE=openai

# Browser to read cookies from (bypasses YouTube bot detection)
# Options: chrome, firefox, brave, edge, safari, opera
COOKIES_BROWSER=
